{
  "name": "odoo-clone",
  "compatibility_date": "2026-11-20",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_ORIGIN": "https://odoo-clone.onrender.com"
  }
}