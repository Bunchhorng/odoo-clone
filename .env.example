COMPOSE_PROJECT_NAME=kerp

DJANGO_SECRET_KEY=REPLACE_WITH_DJANGO_SECRET_KEY
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_DATABASE=kerp
MYSQL_USER=kerp
MYSQL_PASSWORD=REPLACE_WITH_MYSQL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_MYSQL_ROOT_PASSWORD
MYSQL_HOST=db
MYSQL_PORT=3306

# Change a host port if another project already uses it.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Authentication limits are shared in MySQL across backend processes.
AUTH_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_IDENTITY_LIMIT=10
AUTH_LOGIN_IP_LIMIT=100
AUTH_RESET_IDENTITY_LIMIT=3
AUTH_RESET_IP_LIMIT=30
SESSION_COOKIE_AGE=28800
# Optional origin override for recovery links; no path, query, or fragment.
# FRONTEND_ORIGIN=https://erp.example.com

# Local recovery links are written to `docker compose logs mailer`.
# Set the SMTP backend and credentials only when you intend to send real mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@kerp.local
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Optional: used only by `createsuperuser --noinput`, never on server startup.
DJANGO_SUPERUSER_EMAIL=admin@kerp.local
DJANGO_SUPERUSER_PASSWORD=
